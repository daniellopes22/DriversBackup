*.tmp
*.log
ehthumbs.db
[Dd]esktop.ini

# ============== ARQUIVOS DE SCRIPT ==============
temp_*.txt
backup_*/
DriversBackup_*.log  # Exceto se quiser versionar logs

# ============== IDEs/EDITORES ==============
.vscode/
.idea/
*.suo
*.user

