# ==============================================
# Arquivos temporários e de sistema do Windows
# ==============================================
Thumbs.db    # Banco de dados de miniaturas do Explorer
Desktop.ini  # Configurações personalizadas de pastas
*.tmp        # Arquivos temporários genéricos
*.temp       # Outro padrão comum para temporários
~$*          # Arquivos de lock do Office (ex: ~$Documento.docx)

# ==============================================
# Arquivos específicos gerados pelo script
# ==============================================
temp_*.txt          # Arquivos temporários criados durante a execução
DriversBackup_*.log # Logs diários (exceto se quiser versionar algum)
backup_local/       # Pasta de backup teste (se usar localmente)

# ==============================================
# Configurações de IDEs/Editores
# ==============================================
.vscode/    # Configurações do Visual Studio Code
.idea/      # Configurações do JetBrains IDE
*.suo       # Arquivos de usuário do Visual Studio
*.user      # Configurações pessoais de projetos

# ==============================================
# Binários e arquivos compilados
# ==============================================
*.exe       # Executáveis não versionados
*.dll       # Bibliotecas dinâmicas
*.bak       # Backups acidentais de arquivos
